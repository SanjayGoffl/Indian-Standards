# Groq Credentials
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=<your-groq-model>

# Database
DATABASE_URL=postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/querynest

# JWT Authentication
JWT_SECRET_KEY=replace_this_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
